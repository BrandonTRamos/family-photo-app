{
  "name": "family-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p amplify/tsconfig.json --noEmit",
    "test": "vitest run && ARCHIVE_REPO=memory vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.7",
    "@aws-sdk/client-bedrock-runtime": "^3.1162.0",
    "@aws-sdk/client-dynamodb": "^3.1162.0",
    "@aws-sdk/client-mediaconvert": "^3.1162.0",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/client-sqs": "^3.1162.0",
    "@aws-sdk/lib-dynamodb": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "aws-amplify": "^6.15.7",
    "exifr": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "dynalite": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
